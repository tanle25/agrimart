generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int         @id @default(autoincrement())
  name        String
  slug        String      @unique
  price       Float
  oldPrice    Float?      @default(0)
  image       String?
  images      String[]
  category    String?
  rating      Float       @default(0)
  reviews     Int         @default(0)
  discount    Int         @default(0)
  description String?
  type        String      @default("simple")
  attributes  Json?
  weight      Float?
  dimensions  Json?
  seoTitle    String?
  seoDesc     String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  content     String?
  barcode     String?
  sku         String?
  status      String      @default("active")
  tags        String[]
  vendor      String?
  stock       Int         @default(0)
  mainKeyword String?
  variants    Variant[]
  orderItems  OrderItem[]
}

model Variant {
  id         String      @id @default(uuid())
  productId  Int
  name       String
  price      Float
  salePrice  Float?
  stock      Int         @default(0)
  sku        String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  attributes Json?
  image      String?
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
}

model BlogPost {
  id          Int           @id @default(autoincrement())
  title       String
  slug        String        @unique
  excerpt     String?
  content     String?
  image       String?
  date        String?
  author      String?
  readTime    String?
  featured    Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  mainKeyword String?
  seoDesc     String?
  seoTitle    String?
  tags        String[]
  categoryId  Int?
  category    BlogCategory? @relation(fields: [categoryId], references: [id])
}

model BlogCategory {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  slug      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  posts     BlogPost[]
}

model ProductCategory {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  image       String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Settings {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model Order {
  id              Int         @id @default(autoincrement())
  customerName    String
  customerPhone   String
  customerEmail   String?
  shippingAddress String      @db.Text
  city            String?
  district        String?
  ward            String?
  note            String?     @db.Text
  totalAmount     Float
  shippingFee     Float       @default(0)
  paymentMethod   String      @default("cod") // cod, banking, momo
  status          String      @default("pending") // pending, confirmed, shipping, completed, cancelled
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]
}

model OrderItem {
  id          Int      @id @default(autoincrement())
  orderId     Int
  productId   Int
  variantId   String?
  productName String
  image       String?
  price       Float
  quantity    Int
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])
  variant     Variant? @relation(fields: [variantId], references: [id])
}

model Province {
  code      String     @id
  name      String
  fullName  String?
  districts District[]
}

model District {
  code         String   @id
  name         String
  fullName     String?
  provinceCode String
  province     Province @relation(fields: [provinceCode], references: [code])
  wards        Ward[]
}

model Ward {
  code         String   @id
  name         String
  fullName     String?
  districtCode String
  district     District @relation(fields: [districtCode], references: [code])
}

model ProvinceV2 {
  code     String   @id
  name     String
  fullName String?
  codename String
  wards    WardV2[]
}

model WardV2 {
  code         String     @id
  name         String
  fullName     String?
  codename     String
  provinceCode String
  province     ProvinceV2 @relation(fields: [provinceCode], references: [code])
}

model DailyStat {
  date    DateTime @id @db.Date
  views   Int      @default(0)
  orders  Int      @default(0)
  revenue Float    @default(0)
}
